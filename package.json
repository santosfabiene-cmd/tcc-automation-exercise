    "test:xpath": "cypress run --browser chrome --env seletores=xpath"
  },
  "devDependencies": {
    "cypress": "13.7.3",
    "cypress-xpath": "2.0.1",
    "cypress-mochawesome-reporter": "3.8.2"
  }
}
